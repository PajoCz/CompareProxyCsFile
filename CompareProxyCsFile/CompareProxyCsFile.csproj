<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    
    <!-- Package Metadata -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>compareproxy</ToolCommandName>
    <PackageId>CompareProxyCsFile</PackageId>
    <Version>1.0.0</Version>
    <Authors>PajoCz</Authors>
    <Product>CompareProxyCsFile</Product>
    <Description>A semantic comparison tool for auto-generated C# proxy files. Intelligently compares WCF service references while ignoring generator versions and type ordering.</Description>
    <Copyright>Copyright © 2025 PajoCz</Copyright>
    <PackageProjectUrl>https://github.com/PajoCz/CompareProxyCsFile</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PajoCz/CompareProxyCsFile</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>csharp;proxy;comparison;wcf;roslyn;code-analysis;semantic;diff</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial release with semantic proxy comparison</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
